# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Configuration (for payments)
# Get these from https://dashboard.stripe.com/apikeys
# Use pk_test_* and sk_test_* for testing, pk_live_* and sk_live_* for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Payment Links - Create these in Stripe Dashboard (Payment Links section)
# Use LIVE mode links for production (URLs start with https://buy.stripe.com/live_...)
# Set the success URL to: https://glamatron.com?payment=success&coins=X (replace X with coin amount)
# Set the cancel URL to: https://glamatron.com?payment=cancelled
VITE_STRIPE_LINK_5_COINS=https://buy.stripe.com/your_5_coin_link
VITE_STRIPE_LINK_10_COINS=https://buy.stripe.com/your_10_coin_link
VITE_STRIPE_LINK_25_COINS=https://buy.stripe.com/your_25_coin_link

# Optional: Stripe Price IDs (for webhook price matching)
# If not set, webhook falls back to amount-based detection ($2.99=5, $4.99=10, $9.99=25)
# STRIPE_PRICE_5_COINS=price_1Qxxxxxxxxx
# STRIPE_PRICE_10_COINS=price_1Qxxxxxxxxx
# STRIPE_PRICE_25_COINS=price_1Qxxxxxxxxx

# Supabase Service Role Key (for server-side operations like webhook)
# Get this from https://supabase.com/dashboard/project/_/settings/api (service_role key - KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend Configuration (for contact form emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
